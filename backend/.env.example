# Supabase: Project Settings > Database > Connection string (use the "Session pooler" URI)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
JWT_SECRET=put-a-long-random-string-here
# Your Vercel frontend URL (comma separated if more than one). Use * only for local testing.
CLIENT_ORIGIN=http://localhost:5173
